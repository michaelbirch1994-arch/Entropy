{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entropy",
  "version": "0.2.96",
  "identifier": "com.entropy.wvw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Entropy",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost 'self' https://dps.report https://b.dps.report https://api.guildwars2.com https://gw2skills.net https://*.gw2skills.net https://discord.com https://discordapp.com https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NUE3NEY0MEI1Qzc3NkYKUldSdmQxd0w5SFJhVk02TVhFOVZzeFczd2Zmc293TE5aWmlxcEp5REUvUFdRVDRDaXM4eEE1VU8K",
      "endpoints": [
        "https://github.com/michaelbirch1994-arch/Entropy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
